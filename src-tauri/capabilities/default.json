{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Explicit command and plugin capability for Portal's main wallet window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://mempool.citadelfoss.xyz/*"
        },
        {
          "url": "https://github.com/citadel-tech/coinswap/*"
        }
      ]
    },
    "allow-backup-wallet",
    "allow-check-backend",
    "allow-check-maker-ports",
    "allow-check-tor",
    "allow-choose-restore-backup",
    "allow-clear-maker-settings",
    "allow-estimate-fees",
    "allow-estimate-swap-funding",
    "allow-get-balances",
    "allow-get-btc-price",
    "allow-get-chain-backend",
    "allow-get-incoming-swap-utxo",
    "allow-get-logs",
    "allow-get-maker-balances",
    "allow-get-maker-info",
    "allow-get-maker-logs",
    "allow-get-maker-new-address",
    "allow-get-maker-status",
    "allow-get-maker-swap-report",
    "allow-get-maker-transactions",
    "allow-get-new-address",
    "allow-get-offers",
    "allow-get-recovery-status",
    "allow-get-saved-maker-settings",
    "allow-get-router-defaults",
      "allow-get-suggested-maker-ports",
    "allow-get-swap-preparation",
    "allow-get-swap-progress",
    "allow-get-swap-report",
    "allow-get-swap-tracker",
    "allow-get-transactions",
    "allow-shutdown-taker",
    "allow-get-paths",
    "allow-get-session-state",
    "allow-get-wallet-info",
    "allow-import-dashboard-makers",
    "allow-init-maker",
    "allow-init-taker",
    "allow-list-dashboard-imports",
    "allow-list-maker-fidelity-bonds",
    "allow-list-maker-swap-reports",
    "allow-list-maker-utxos",
    "allow-list-makers",
    "allow-list-swap-reports",
    "allow-list-utxos",
    "allow-list-wallets",
    "allow-poll-maker",
    "allow-prepare-swap",
    "allow-quit-app",
    "allow-list-recoveries",
    "allow-recover-swap",
    "allow-remove-maker",
    "allow-restart-tor-bootstrap",
    "allow-restore-wallet",
    "allow-send-to-address",
    "allow-set-chain-backend",
    "allow-start-maker",
    "allow-start-swap",
    "allow-stop-maker",
    "allow-send-maker-to-address",
      "allow-sync-maker-wallet",
    "allow-sync-offerbook",
    "allow-sync-wallet",
    "allow-update-maker-settings",
    "allow-validate-address",
    "allow-verify-deniability",
    "allow-verify-last-address",
    "allow-verify-maker-deniability"
  ]
}
